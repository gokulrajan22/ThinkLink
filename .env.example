# Copy to .env. Never commit .env or paste secrets into chat.
# Groq API keys and rate limits are managed separately from ChatGPT subscriptions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional GitHub token for a higher rate limit when reading public repositories.
# Use a fine-grained token with public read access only; AIMORA never writes to GitHub.
GITHUB_TOKEN=

# Optional hosted PostgreSQL URL (Neon Free is the selected $0/month option).
# Keep the full connection string private; do not commit it.
DATABASE_URL=

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False  # Set True in production

# Required only if running the separate private FastAPI service.
# Generate a long random token and store it only in server-side secrets.
INTERNAL_API_TOKEN=

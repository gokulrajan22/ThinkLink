# Copy to .env locally. Never commit .env or paste secrets into chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional GitHub token for public GitHub API rate limits; public read only.
GITHUB_TOKEN=

# SMTP provider credentials for verification and password recovery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ThinkLink <no-reply@example.com>

# Persistent hosted PostgreSQL connection string.
DATABASE_URL=

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False

# Only needed if separately deploying the private FastAPI service.
INTERNAL_API_TOKEN=
